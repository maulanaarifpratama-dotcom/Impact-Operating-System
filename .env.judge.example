# Hackathon judge demo account — configuration for scripts/seed-judge-demo.mjs
#
# Copy to .env.judge and fill in. .env.judge is gitignored and MUST stay that
# way: it holds a service role key and a password handed to outside judges.
#
#   cp .env.judge.example .env.judge
#   node scripts/seed-judge-demo.mjs

# Service role key — Supabase Dashboard > Project Settings > API.
# Full bypass of RLS. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# The judge account. Use an address you control and can retire after judging.
JUDGE_EMAIL=juri@impactory.id

# Minimum 16 characters, randomly generated. The seed script rejects weak or
# guessable values. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
JUDGE_PASSWORD=

# Optional. Defaults to "Yayasan Demo Juri Impactory".
JUDGE_ORG_NAME=

# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are read from .env — no need to
# repeat them here.
