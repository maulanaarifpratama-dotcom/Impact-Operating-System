# Hackathon reviewer account — configuration for scripts/seed-judge-demo.mjs
#
# Copy to .env.judge and fill in. .env.judge is gitignored and MUST stay that
# way: it holds a service role key and a password handed to outside reviewers.
#
#   cp .env.judge.example .env.judge
#   node scripts/seed-judge-demo.mjs

# Service role key — Supabase Dashboard > Project Settings > API.
# Bypasses RLS entirely. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# The reviewer account. Use an address you control and can retire afterwards.
JUDGE_EMAIL=reviewer@impactory.id

# Minimum 16 characters, randomly generated. The seed script rejects weak or
# guessable values. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
JUDGE_PASSWORD=

# Optional. Defaults to "Impactory Demo Org (Hackathon Review)".
JUDGE_ORG_NAME=

# Optional. The URL given to reviewers. Defaults to the production deployment.
JUDGE_APP_URL=https://impactory.vercel.app

# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are read from .env — no need to
# repeat them here.
