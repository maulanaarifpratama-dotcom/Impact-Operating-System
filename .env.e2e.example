# Impactory Playwright E2E Smoke Test Environment Variables
# Copy this file to .env.e2e and fill in your values
# DO NOT COMMIT THE ACTUAL .env.e2e FILE!

# Base URL of the running application (dev or staging)
E2E_BASE_URL=http://localhost:5173

# Test User Credentials (use a dedicated test account)
E2E_USER_EMAIL=test-user@impactory.id
E2E_USER_PASSWORD=YourSecureTestPassword123

# Optional: ID of an existing LFA project to bypass creation/indexing
E2E_TEST_PROJECT_ID=11111111-1111-1111-1111-111111111111

# Set to 1 to run SROI AI-suggest narrative validations (disabled by default)
RUN_AI_SMOKE=0
